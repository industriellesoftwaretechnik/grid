{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "types": ["vite/client"],
    // The workspace packages resolve to their sources, so the demo hot-reloads grid changes without a build.
    "paths": {
      "@/*": ["./src/*"],
      "@istec/grid-core": ["../../packages/grid-core/src/index.ts"],
      "@istec/grid-ui": ["../../packages/grid-ui/src/index.ts"]
    }
  },
  "include": ["src"]
}
