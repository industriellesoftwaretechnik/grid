{
  "name": "@istec/grid-ui",
  "version": "0.0.0",
  "description": "Styled React data grid built on @istec/grid-core, Tailwind CSS v4 and shadcn-style components.",
  "keywords": [
    "data-grid",
    "react",
    "shadcn",
    "table",
    "tailwindcss",
    "tanstack-table"
  ],
  "homepage": "https://github.com/industriellesoftwaretechnik/grid/tree/main/packages/grid-ui#readme",
  "bugs": "https://github.com/industriellesoftwaretechnik/grid/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/industriellesoftwaretechnik/grid.git",
    "directory": "packages/grid-ui"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@istec/grid-core": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "catalog:"
  },
  "devDependencies": {
    "@tanstack/react-table": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-table": "^9",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4"
  }
}
