{
  "name": "@istec/grid-core",
  "version": "0.0.0",
  "description": "Headless data grid for React: hooks, TanStack Table features and pure logic, no styling.",
  "keywords": [
    "data-grid",
    "headless",
    "react",
    "table",
    "tanstack-table"
  ],
  "homepage": "https://github.com/industriellesoftwaretechnik/grid/tree/main/packages/grid-core#readme",
  "bugs": "https://github.com/industriellesoftwaretechnik/grid/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/industriellesoftwaretechnik/grid.git",
    "directory": "packages/grid-core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@tanstack/react-pacer": "0.24.1",
    "@tanstack/react-store": "^0.11.2",
    "@tanstack/react-virtual": "^3.14.26"
  },
  "devDependencies": {
    "@tanstack/react-table": "catalog:",
    "@tanstack/table-core": "9.3.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-table": "^9",
    "react": "^19",
    "react-dom": "^19"
  }
}
