{
  "name": "@istec/grid",
  "version": "0.1.0",
  "description": "React data grid on TanStack Table: a complete grid with its UI, built on Base UI and styled with a prebuilt, prefixed Tailwind CSS stylesheet.",
  "keywords": [
    "data-grid",
    "react",
    "table",
    "tanstack-table"
  ],
  "homepage": "https://github.com/industriellesoftwaretechnik/grid/tree/main/packages/grid#readme",
  "bugs": "https://github.com/industriellesoftwaretechnik/grid/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/industriellesoftwaretechnik/grid.git",
    "directory": "packages/grid"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack && tailwindcss -i src/styles.css -o dist/styles.css --minify",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@tanstack/react-pacer": "0.24.1",
    "@tanstack/react-store": "^0.11.2",
    "@tanstack/react-virtual": "^3.14.26",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.69.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@tanstack/react-table": "catalog:",
    "@tanstack/table-core": "9.3.1",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-table": "^9",
    "react": "^19",
    "react-dom": "^19"
  }
}
